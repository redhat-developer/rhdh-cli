  "backstage": { "role": "backend-plugin", "pluginId": "example-plugin" },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "yarn tsc && backstage-cli package build",
    "tsc": "tsc --declaration",
    "test": "backstage-cli package test --passWithNoTests"
  },
