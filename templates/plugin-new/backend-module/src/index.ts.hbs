import { createBackendModule } from '@backstage/backend-plugin-api';
import {
  catalogProcessingExtensionPoint,
  type CatalogProcessor,
} from '@backstage/plugin-catalog-node';

const processor: CatalogProcessor = {
  getProcessorName: () => '{{pluginId}}Processor',
};

const module = createBackendModule({
  pluginId: 'catalog',
  moduleId: '{{pluginId}}',
  register(reg) {
    reg.registerInit({
      deps: { catalog: catalogProcessingExtensionPoint },
      async init({ catalog }) {
        catalog.addProcessor(processor);
      },
    });
  },
});

export default module;
